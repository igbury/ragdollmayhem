-- Generated by assets/port/gen_install.py from manifest.json. Run once in Studio, in EDIT mode,
-- after PortKit.glb is on Roblox, either way:
--  * uploaded through Open Cloud as a Model: set MODEL_ID to its asset id;
--  * imported with Studio's File > Import 3D: leave MODEL_ID 0, the imported "PortKit" (or "Scene") in Workspace is used.
-- Then save the place. Each MeshPart gets a "Place" attribute: its CFrame in its piece's space.
local MODEL_ID = 0

local KIT = { -- [mesh name] = { piece, colour, its centre in the piece's space (studs), neon, transparency }
	["Port_CraneBoom__2E6FB0"] = { "Port_CraneBoom", "2E6FB0", Vector3.new(-0.0, 54.675, 18.0), false, 0 },
	["Port_CraneBoom__464A52"] = { "Port_CraneBoom", "464A52", Vector3.new(-0.0, 55.6977, 18.0), false, 0 },
	["Port_CraneBoom__EBB91E"] = { "Port_CraneBoom", "EBB91E", Vector3.new(-0.0, 45.95, 18.0), false, 0 },
	["Port_CraneBoom__FF3030"] = { "Port_CraneBoom", "FF3030", Vector3.new(-0.0, 46.6, 79.5), true, 0 },
	["Port_CraneHouse__EBEBE6"] = { "Port_CraneHouse", "EBEBE6", Vector3.new(-0.0, 48.0, 0.0), false, 0 },
	["Port_CraneHouse__2E6FB0"] = { "Port_CraneHouse", "2E6FB0", Vector3.new(-0.0, 50.5, 0.0), false, 0 },
	["Port_CraneHouse__2A2D33"] = { "Port_CraneHouse", "2A2D33", Vector3.new(-0.0, 45.5, 0.0), false, 0 },
	["Port_CraneHouse__464A52"] = { "Port_CraneHouse", "464A52", Vector3.new(-0.0, 44.6, 0.0), false, 0 },
	["Port_CraneHouse__96D2F5"] = { "Port_CraneHouse", "96D2F5", Vector3.new(-0.0, 47.6, 2.5), false, 0.3 },
	["Port_CraneHouse__EBB91E"] = { "Port_CraneHouse", "EBB91E", Vector3.new(-0.0, 54.6, 0.0), false, 0 },
	["Port_CranePortal__464A52"] = { "Port_CranePortal", "464A52", Vector3.new(-0.0, 1.65, 0.0), false, 0 },
	["Port_CranePortal__2A2D33"] = { "Port_CranePortal", "2A2D33", Vector3.new(-0.0, 0.85, 0.0), false, 0 },
	["Port_CranePortal__2E6FB0"] = { "Port_CranePortal", "2E6FB0", Vector3.new(-0.0, 22.225, 0.0), false, 0 },
	["Port_CranePortal__EBEBE6"] = { "Port_CranePortal", "EBEBE6", Vector3.new(-0.0, 35.7, 0.0), false, 0 },
	["Port_CranePortal__EBB91E"] = { "Port_CranePortal", "EBB91E", Vector3.new(-0.0, 38.5, 0.0), false, 0 },
	["Port_CraneTrolley__EBB91E"] = { "Port_CraneTrolley", "EBB91E", Vector3.new(-0.0, 33.0, 56.0), false, 0 },
	["Port_CraneTrolley__EBEBE6"] = { "Port_CraneTrolley", "EBEBE6", Vector3.new(-0.0, 35.5, 56.0), false, 0 },
	["Port_CraneTrolley__96D2F5"] = { "Port_CraneTrolley", "96D2F5", Vector3.new(-0.0, 36.0, 56.615), false, 0.3 },
	["Port_CraneTrolley__464A52"] = { "Port_CraneTrolley", "464A52", Vector3.new(-0.0, 31.5, 56.0), false, 0 },
	["Port_CraneTrolley__2A2D33"] = { "Port_CraneTrolley", "2A2D33", Vector3.new(-0.0, 24.5, 56.0), false, 0 },
	["Port_Hull__1C1C20"] = { "Port_Hull", "1C1C20", Vector3.new(-0.0, 1.5, 0.0), false, 0 },
	["Port_Hull__EBEBE6"] = { "Port_Hull", "EBEBE6", Vector3.new(-0.095, 1.0, 0.0), false, 0 },
