	["Port_Hull__5A5E66"] = { "Port_Hull", "5A5E66", Vector3.new(1.0, -2.0, 0.0), false, 0 },
	["Port_Hull__B08D57"] = { "Port_Hull", "B08D57", Vector3.new(-81.2, -14.0, 0.0), false, 0 },
}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local loaded = if MODEL_ID ~= 0 then game:GetObjects("rbxassetid://" .. MODEL_ID)[1] else workspace:FindFirstChild("PortKit") or workspace:FindFirstChild("Scene")
assert(loaded, "no PortKit: set MODEL_ID, or import PortKit.glb with File > Import 3D first")
local old = ReplicatedStorage:FindFirstChild("PortKit")
if old then
	old:Destroy()
end
local kit = Instance.new("Folder")
kit.Name = "PortKit"
local found, missing = 0, {}
for _, p in loaded:GetDescendants() do
	local info = p:IsA("MeshPart") and KIT[p.Name]
	if info then
		local folder = kit:FindFirstChild(info[1]) or Instance.new("Folder")
		folder.Name = info[1]
		folder.Parent = kit
		p.Name = info[2]
		p.Color = Color3.fromHex(info[2])
		p.Material = info[4] and Enum.Material.Neon or Enum.Material.SmoothPlastic
		p.Transparency = info[5]
		p.CFrame = CFrame.identity
		-- decoration only: Port.luau keeps its stand-in parts as the (invisible) collision
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.CollisionFidelity = Enum.CollisionFidelity.Box
		p.DoubleSided = true
		p.CastShadow = not info[4]
		p.RenderFidelity = Enum.RenderFidelity.Precise -- the automatic LOD hollows thin shells at range
		-- where it sits in its piece's space. The importer turns every mesh 180 degrees about Y
		-- (measured on the army kit's helicopter beacon and nav light), so the place carries the turn back.
		p:SetAttribute("Place", CFrame.new(info[3]) * CFrame.Angles(0, math.pi, 0))
		p.Parent = folder
		found += 1
	end
end
for name in KIT do
	local piece = string.split(name, "__")[1]
	local colour = string.split(name, "__")[2]
	if not (kit:FindFirstChild(piece) and kit[piece]:FindFirstChild(colour)) then
		table.insert(missing, name)
	end
end
loaded:Destroy()
kit.Parent = ReplicatedStorage
return ("PortKit: %d of %d meshes in; missing: %s"):format(found, 25, table.concat(missing, ", "))
