-- Poses must nest along the R15 skeleton; flat under the Keyframe they move nothing.
local PARENT = {
	LowerTorso = "HumanoidRootPart", UpperTorso = "LowerTorso", Head = "UpperTorso",
	LeftUpperArm = "UpperTorso", LeftLowerArm = "LeftUpperArm", LeftHand = "LeftLowerArm",
	RightUpperArm = "UpperTorso", RightLowerArm = "RightUpperArm", RightHand = "RightLowerArm",
	LeftUpperLeg = "LowerTorso", LeftLowerLeg = "LeftUpperLeg", LeftFoot = "LeftLowerLeg",
	RightUpperLeg = "LowerTorso", RightLowerLeg = "RightUpperLeg", RightFoot = "RightLowerLeg",
}

local function build()
	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = "SprintFlail"
	sequence.Loop = true
	sequence.Priority = Enum.AnimationPriority.Movement
	for _, key in ipairs(keys) do
		local frame = Instance.new("Keyframe")
		frame.Time = key.t
		local byName = {}
		for _, entry in ipairs(key.poses) do -- listed parent-first
			local pose = Instance.new("Pose")
			pose.Name = entry[1]
			pose.CFrame = entry[2]
			pose.EasingStyle = key.style
			pose.EasingDirection = key.dir
			pose.Weight = 1
			pose.Parent = byName[PARENT[entry[1]]] or frame
			byName[entry[1]] = pose
		end
		frame.Parent = sequence
	end
	return sequence
end

local sequence = build()
return sequence
